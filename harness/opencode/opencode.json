{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      ".env": "deny",
      "**/.env": "deny",
      "**/.env.local": "deny",
      "**/.env.production": "deny",
      "**/.env.staging": "deny",
      "**/credentials.json": "deny",
      "**/service-account.json": "deny"
    },
    "edit": {
      ".env": "deny",
      "**/.env": "deny",
      "**/.env.local": "deny",
      "**/.env.production": "deny",
      "**/.env.staging": "deny",
      "**/credentials.json": "deny",
      "**/service-account.json": "deny"
    },
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "terraform apply*": "ask",
      "terraform destroy*": "ask",
      "terraform import*": "ask",
      "kubectl apply*": "ask",
      "kubectl delete*": "ask",
      "kubectl replace*": "ask",
      "kubectl patch*": "ask"
    }
  }
}
prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Remote Git mutation requires explicit approval.",
)

prefix_rule(
    pattern = ["terraform", ["apply", "destroy", "import"]],
    decision = "prompt",
    justification = "Infrastructure mutation requires explicit approval.",
)

prefix_rule(
    pattern = ["kubectl", ["apply", "delete", "replace", "patch"]],
    decision = "prompt",
    justification = "Cluster mutation requires explicit approval.",
)

#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import subprocess
import sys
from contextlib import contextmanager
from pathlib import Path

ROOT = Path(__file__).resolve().parent
SCRIPTS = ROOT / "scripts" / "ae-sdlc"
if str(SCRIPTS) not in sys.path:
    sys.path.insert(0, str(SCRIPTS))
from work import commands as work_commands
from work.backend import WorkBackendError
from work.config import backend_name, load_backend, read_config, set_backend
from work.delegate import run_backend_command, run_package_command
from work.service import WorkService
import providers
import run_workflow


def run_agent(provider: str | None, skill: str, args: str, tail: str, schema: Path, model: str | None) -> int:
    adapter = providers.load(providers.resolve(provider))
    adapter.check_cli()
    rc, result = adapter.run(skill, args, tail, schema, model)
    if result is not None:
        print(json.dumps(result, indent=2, ensure_ascii=False))
    else:
        print("no structured result produced", file=sys.stderr)
        rc = rc or 1
    return rc


def run_backend(a: argparse.Namespace) -> int:
    active = backend_name(ROOT)
    if a.backend_cmd == "connect":
        return run_backend_command(ROOT, Path(__file__), "connect", a.provider)
    if a.backend_cmd == "use" and a.name != "local":
        return run_backend_command(ROOT, Path(__file__), "use", a.name)
    if a.backend_cmd == "use":
        set_backend(ROOT, "local")
        print("Active backend: local")
        return 0
    if a.backend_cmd == "doctor":
        if active != "local":
            return run_backend_command(ROOT, Path(__file__), "doctor", active)
        print("OK       local backend — no credentials or network required")
        return 0
    print(f"Active backend: {active}")
    for table, values in read_config(ROOT).items():
        if table != "work" and isinstance(values, dict):
            print(f"[{table}] " + ", ".join(f"{k}={v}" for k, v in values.items()))
    return 0


@contextmanager
def local_service():
    yield WorkService(load_backend(ROOT))


def run_work(argv: list[str]) -> int:
    """Parse here so usage errors and --help need no installed package; a remote backend gets the raw arguments."""
    args = work_commands.parse(argv)
    try:
        if backend_name(ROOT) == "local":
            return work_commands.execute(args, local_service)
        return run_package_command(ROOT, Path(__file__), ["work", *argv])
    except WorkBackendError as exc:
        return work_commands.fail(exc)


def main() -> int:
    if sys.argv[1:2] == ["work"]:  # argparse's REMAINDER cannot start with an option such as --help
        return run_work(sys.argv[2:])
    ap = argparse.ArgumentParser(description="Thin command-driven AE-SDLC")
    ap.add_argument("--provider", "-p", help="agent CLI to use (default: the only installed provider or $AE_SDLC_PROVIDER)")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("prepare-work")
    p.add_argument("request", nargs="+")
    p.add_argument("--model")

    p = sub.add_parser("execute-work")
    p.add_argument("refs", nargs="+")
    p.add_argument("--model")

    p = sub.add_parser("workflow")
    p.add_argument("workflow")
    p.add_argument("scope")
    p.add_argument("--model")
    p.add_argument("--max-specs", type=int)

    p = sub.add_parser("status")
    p.add_argument("scope", nargs="?")
    g = p.add_mutually_exclusive_group()
    g.add_argument("--ready", action="store_true")
    g.add_argument("--blocked", action="store_true")

    sub.add_parser("validate")

    p = sub.add_parser("backend", help="select and verify where work is stored")
    backend = p.add_subparsers(dest="backend_cmd", required=True)
    b = backend.add_parser("connect", help="store credentials and choose the team or project")
    b.add_argument("provider", choices=["linear", "jira"])
    b = backend.add_parser("use", help="activate a backend")
    b.add_argument("name", choices=["local", "linear", "jira"])
    backend.add_parser("show", help="print the active backend and its settings")
    backend.add_parser("doctor", help="verify the active backend with real calls")

    p = sub.add_parser("work", add_help=False, help="work-management commands for skills and runners (JSON)")
    p.add_argument("argv", nargs=argparse.REMAINDER)

    a = ap.parse_args()
    schemas = ROOT / ".ae-sdlc" / "schemas"

    if a.cmd == "work":
        return run_work(a.argv)

    if a.cmd == "backend":
        try:
            return run_backend(a)
        except WorkBackendError as exc:
            raise SystemExit(str(exc))

    if a.cmd in {"prepare-work", "execute-work", "workflow"}:
        providers.remove_tracker_credentials_from_env()

    if a.cmd == "prepare-work":
        return run_agent(a.provider, "prepare-work", " ".join(a.request), providers.PREPARE_TAIL,
                         schemas / "prepare-result.schema.json", a.model)

    if a.cmd == "execute-work":
        return run_agent(a.provider, "execute-work", " ".join(a.refs), providers.EXECUTE_TAIL,
                         schemas / "execute-result.schema.json", a.model)

    if a.cmd == "workflow":
        argv = [a.workflow, a.scope]
        if a.provider:
            argv += ["--provider", a.provider]
        if a.model:
            argv += ["--model", a.model]
        if a.max_specs:
            argv += ["--max-specs", str(a.max_specs)]
        return run_workflow.main(argv)

    if a.cmd == "status":
        only = "READY" if a.ready else "BLOCKED" if a.blocked else None
        try:
            if backend_name(ROOT) != "local":
                scope_args = [a.scope] if a.scope else []
                return run_package_command(ROOT, Path(__file__), ["status", *scope_args,
                                                                  *(["--status", only] if only else [])])
            service = WorkService(load_backend(ROOT))
        except WorkBackendError as exc:
            raise SystemExit(str(exc))
        for line in service.status_lines(a.scope, only_status=only):
            print(line)
        return 0

    if a.cmd == "validate":
        return subprocess.run([sys.executable, str(SCRIPTS / "validate_harness.py")], cwd=ROOT).returncode

    return 2


if __name__ == "__main__":
    raise SystemExit(main())

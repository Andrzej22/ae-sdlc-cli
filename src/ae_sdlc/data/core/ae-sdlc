#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent
SCRIPTS = ROOT / "scripts" / "ae-sdlc"
if str(SCRIPTS) not in sys.path:
    sys.path.insert(0, str(SCRIPTS))
from work.backend import WorkBackendError
from work.config import load_backend
from work.service import WorkService
import providers
import run_workflow


def run_agent(provider: str | None, skill: str, args: str, tail: str, schema: Path, model: str | None) -> int:
    adapter = providers.load(providers.resolve(provider))
    adapter.check_cli()
    rc, result = adapter.run(skill, args, tail, schema, model)
    if result is not None:
        print(json.dumps(result, indent=2, ensure_ascii=False))
    else:
        print("no structured result produced", file=sys.stderr)
        rc = rc or 1
    return rc


def main() -> int:
    ap = argparse.ArgumentParser(description="Thin command-driven AE-SDLC")
    ap.add_argument("--provider", "-p", help="agent CLI to use (default: the only installed provider or $AE_SDLC_PROVIDER)")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("prepare-work")
    p.add_argument("request", nargs="+")
    p.add_argument("--model")

    p = sub.add_parser("execute-work")
    p.add_argument("refs", nargs="+")
    p.add_argument("--model")

    p = sub.add_parser("workflow")
    p.add_argument("workflow")
    p.add_argument("scope")
    p.add_argument("--model")
    p.add_argument("--max-specs", type=int)

    p = sub.add_parser("status")
    p.add_argument("scope", nargs="?")
    g = p.add_mutually_exclusive_group()
    g.add_argument("--ready", action="store_true")
    g.add_argument("--blocked", action="store_true")

    sub.add_parser("validate")

    a = ap.parse_args()
    schemas = ROOT / ".ae-sdlc" / "schemas"

    if a.cmd == "prepare-work":
        return run_agent(a.provider, "prepare-work", " ".join(a.request), providers.PREPARE_TAIL,
                         schemas / "prepare-result.schema.json", a.model)

    if a.cmd == "execute-work":
        return run_agent(a.provider, "execute-work", " ".join(a.refs), providers.EXECUTE_TAIL,
                         schemas / "execute-result.schema.json", a.model)

    if a.cmd == "workflow":
        argv = [a.workflow, a.scope]
        if a.provider:
            argv += ["--provider", a.provider]
        if a.model:
            argv += ["--model", a.model]
        if a.max_specs:
            argv += ["--max-specs", str(a.max_specs)]
        return run_workflow.main(argv)

    if a.cmd == "status":
        try:
            service = WorkService(load_backend(ROOT))
        except WorkBackendError as exc:
            raise SystemExit(str(exc))
        only = "READY" if a.ready else "BLOCKED" if a.blocked else None
        for line in service.status_lines(a.scope, only_status=only):
            print(line)
        return 0

    if a.cmd == "validate":
        return subprocess.run([sys.executable, str(SCRIPTS / "validate_harness.py")], cwd=ROOT).returncode

    return 2


if __name__ == "__main__":
    raise SystemExit(main())

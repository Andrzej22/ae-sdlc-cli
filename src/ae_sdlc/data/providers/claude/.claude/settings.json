{
  "permissions": {
    "allow": [
      "Bash(ae-sdlc work:*)",
      "Bash(ae-sdlc status:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/credentials.json)",
      "Read(**/service-account.json)",
      "Edit(./.env)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.production)",
      "Edit(**/.env.staging)",
      "Edit(**/credentials.json)",
      "Edit(**/service-account.json)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform import:*)",
      "Bash(kubectl apply:*)",
      "Bash(kubectl delete:*)",
      "Bash(kubectl replace:*)",
      "Bash(kubectl patch:*)"
    ]
  },
  "sandbox": {
    "network": {
      "allowedDomains": [
        "mcp.linear.app",
        "mcp.atlassian.com"
      ]
    }
  }
}

{
  "permissions": {
    "allow": [
      "Shell(ae-sdlc work:*)",
      "Shell(ae-sdlc status:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/credentials.json)",
      "Read(**/service-account.json)",
      "Write(.env)",
      "Write(**/.env)",
      "Write(**/.env.local)",
      "Write(**/.env.production)",
      "Write(**/.env.staging)",
      "Write(**/credentials.json)",
      "Write(**/service-account.json)",
      "Shell(git push:*)",
      "Shell(terraform apply:*)",
      "Shell(terraform destroy:*)",
      "Shell(terraform import:*)",
      "Shell(kubectl apply:*)",
      "Shell(kubectl delete:*)",
      "Shell(kubectl replace:*)",
      "Shell(kubectl patch:*)"
    ]
  }
}
